{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "44rem",
			"wideSize": "84rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "navy",
					"name": "Navy",
					"color": "#071533"
				},
				{
					"slug": "navy-raised",
					"name": "Navy (raised)",
					"color": "#0C1D44"
				},
				{
					"slug": "navy-light",
					"name": "Navy (light)",
					"color": "#13285A"
				},
				{
					"slug": "gold",
					"name": "Gold",
					"color": "#D8A848"
				},
				{
					"slug": "gold-light",
					"name": "Gold (light)",
					"color": "#E9C46A"
				},
				{
					"slug": "gold-deep",
					"name": "Gold (text on light)",
					"color": "#86600F"
				},
				{
					"slug": "slate",
					"name": "Slate",
					"color": "#5B6478"
				},
				{
					"slug": "fog",
					"name": "Fog",
					"color": "#A9B3C9"
				},
				{
					"slug": "bone",
					"name": "Cool grey",
					"color": "#EEF1F6"
				},
				{
					"slug": "paper",
					"name": "Light grey",
					"color": "#F6F7F9"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				}
			]
		},
		"typography": {
			"fluid": true,
			"dropCap": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Geist",
					"fontFamily": "\"Geist\", \"Geist Fallback\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif"
				},
				{
					"slug": "sans",
					"name": "Geist (text)",
					"fontFamily": "\"Geist\", \"Geist Fallback\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "lede",
					"name": "Lede",
					"size": "1.3125rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.3125rem"
					}
				},
				{
					"slug": "h3",
					"name": "Heading 3",
					"size": "2rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					}
				},
				{
					"slug": "h2",
					"name": "Heading 2",
					"size": "3.5rem",
					"fluid": {
						"min": "2rem",
						"max": "3.5rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "5.75rem",
					"fluid": {
						"min": "2.75rem",
						"max": "5.75rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "2.5rem"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(3rem, 6vw, 5rem)"
				},
				{
					"slug": "70",
					"name": "Section",
					"size": "clamp(4.5rem, 10vw, 9rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--navy)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "1rem",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "inherit"
				}
			}
		}
	}
}
